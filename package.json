{
  "name": "@partyvelope/react-block-cms",
  "version": "0.1.0",
  "description": "블록 기반 콘텐츠 CMS — SSR/SEO 안전한 렌더러 + 실시간 미리보기 admin 에디터 (데이터 계층 무관, React).",
  "keywords": ["cms", "react", "blocks", "page-builder", "ssr", "nextjs", "tailwind", "editor"],
  "license": "MIT",
  "author": "partyvelope",
  "type": "module",
  "sideEffects": ["*.css"],
  "files": ["dist", "src/theme.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js",
      "require": "./dist/editor.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./src/theme.css"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build:js": "tsup",
    "build:css": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify",
    "build": "npm run build:js && npm run build:css",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
